HOST=127.0.0.1
PORT=8080
# 必须替换，两端完全一致；安装脚本会为本地 .env 自动生成。
ONEBOT_ACCESS_TOKEN=replace-with-random-token
LLM_BASE_URL=http://127.0.0.1:32126/v1
LLM_MODEL=deepseek-v4.1-flash
# 已用本机buddyproxy真实识图验证，聊天模型保持不变。
VISION_MODEL=deepseek-v4.1-flash
VISION_MAX_IMAGES=3
VISION_MAX_BYTES=5242880
VISION_TIMEOUT=40
# 明确的“帮我画一张…”或 /draw 描述，使用 buddyproxy Images API，普通聊天不开放其他工具。
IMAGE_MODEL=hunyuan-image-alpha
IMAGE_TIMEOUT=150
# 默认文字；/voice on|off|both 按用户保存，/say 内容 单次朗读。
# auto 优先Edge在线语音，失败回退Windows本地SAPI；也可选edge/sapi/gptsovits/genie/none。
TTS_BACKEND=auto
TTS_VOICE=zh-CN-XiaoxiaoNeural
# genie 完整ONNX后端默认音色；aoi/noto/hayami/edge，用户可通过 /speaker 切换。
TTS_DEFAULT_SPEAKER=aoi
TTS_TIMEOUT=30
TTS_MAX_CHARS=500
# GPT-SoVITS API v2；参考音频路径是语音服务所在机器上的路径。
TTS_BASE_URL=http://127.0.0.1:9880
TTS_REF_AUDIO=
TTS_PROMPT_TEXT=
TTS_PROMPT_LANG=all_ja
TTS_TEXT_LANG=zh
# 可留空，自动读取 ~/.codebuddy/proxy.env 的 CODEBUDDY_PROXY_API_KEY
LLM_API_KEY=
LLM_TIMEOUT=90
# QQ 请求总等待上限（包括排队、限流退避及工具）；慢请求先发送一次提示。
CHAT_TIMEOUT=90
CHAT_NOTICE_SECONDS=8
LLM_MIN_INTERVAL=1
# 仅对上游明确的限流退避；超时、认证失败和其他错误不自动重试。
LLM_RATE_BACKOFF=30
LLM_RATE_RETRIES=2
DB_PATH=data/buddy.sqlite3
# 0 表示关闭按轮数触发，仅按 token 阈值压缩。
COMPRESS_ROUNDS=0
KEEP_ROUNDS=6
CONTEXT_TOKENS=260000
COMPRESS_TOKENS=240000
MAX_INPUT_TOKENS=6000
MAX_REPLY_TOKENS=1200
SUMMARY_TOKENS=1600
MESSAGE_CHARS=1500
# none：只使用 SQLite 上下文；mem0：Mem0 OSS REST；letta：Letta 用户记忆块
MEMORY_BACKEND=none
# Mem0 OSS 示例 http://127.0.0.1:8888；Letta 示例 http://127.0.0.1:8283
# 仅填写服务根地址，不加 /v1；托管 Mem0 Platform API 不兼容此适配器。
MEMORY_BASE_URL=
MEMORY_API_KEY=
MEMORY_TIMEOUT=12
MEMORY_TOP_K=5
MEMORY_CHARS=2400
EMOTION_ENABLED=true
# 持久任务、定时主动执行和工具调用（启动后生效）
TASKS_ENABLED=true
TASK_WORKSPACE=data/tasks
TASK_POLL_SECONDS=1
TASK_CONCURRENCY=2
TASK_MAX_PER_USER=50
TASK_RUN_TIMEOUT=900
TASK_RESULT_CHARS=10000
# DSH 独立容器，只通过本机接口调用；令牌必须独立随机生成。
DSH_BASE_URL=http://127.0.0.1:32128
DSH_TOKEN=
# 本机命令工具默认关闭；管理员通过 QQ /tools shell on 显式开启，状态保存在 SQLite。

# 管理员发送“签到”，跟随代理当前号池；/pool cn|global 切换代理默认号池。
# buddyproxy 若设置管理密码，在此填写（不是模型 API Key）
BUDDY_ADMIN_PASSWORD=
